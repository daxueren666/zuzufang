        <rect x="0" y="192" width="26" height="9" rx="4.5" fill="#1f5fbf"/>
        <rect x="7" y="187" width="12" height="7" rx="3" fill="#1f5fbf"/>
        <circle cx="7" cy="202" r="3.2" fill="#1c2733"/>
        <circle cx="19" cy="202" r="3.2" fill="#1c2733"/>
