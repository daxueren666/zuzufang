        <rect class="cs-win" x="46" y="166" width="10" height="12" rx="2"/>
        <rect class="cs-win" x="94" y="84" width="10" height="12" rx="2"/>
        <rect class="cs-win" x="112" y="84" width="10" height="12" rx="2"/>
        <rect class="cs-win" x="94" y="112" width="10" height="12" rx="2"/>
        <rect class="cs-win" x="112" y="140" width="10" height="12" rx="2"/>
        <rect class="cs-win" x="94" y="168" width="10" height="12" rx="2"/>
