        <line x1="0" y1="-16" x2="0" y2="-21"/><line x1="0" y1="16" x2="0" y2="21"/>
        <line x1="-16" y1="0" x2="-21" y2="0"/><line x1="16" y1="0" x2="21" y2="0"/>
