<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="icon" href="data:,">
<title>{{ target_name }}{% if target_city %}（{{ target_city }}）{% endif %} · 租房参考报告</title>
<style>
  :root{
    --blue-50:#edf3fb; --blue-100:#dce9f9; --blue-200:#c4d8f0;
    --blue-600:#1f5fbf; --blue-800:#1a4f9e;
    --paper:#f3f7fc; --card:#ffffff; --ink:#1c2733; --muted:#5b6b7d;
    --hair:#dbe5ef; --hair2:#c4d8f0;
    --accent:var(--blue-600); --accent-deep:var(--blue-800); --accent-line:var(--blue-200);
    --r-card:16px; --r-ctl:12px;
    --shadow-sm:0 1px 3px rgba(31,95,191,.07);
    --shadow-md:0 6px 24px rgba(31,95,191,.10);
    /* 语义色仅用于风险等级与严重度色条（-t 为文字变体，保证 AA） */
    --red:#c0392b; --red-t:#a93226; --red-bg:#fbeeec;
    --orange:#d35400; --orange-t:#a84300; --orange-bg:#fdf1e5;
    --yellow:#b7950b; --yellow-t:#8a6d00; --yellow-bg:#faf5df;
  }
  *{box-sizing:border-box}
  html,body{height:100%}
  html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
  body{margin:0;overflow:hidden;background:
      radial-gradient(900px 380px at 88% -8%, #e6effb 0%, transparent 62%),
      var(--paper);
    color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","HarmonyOS Sans SC","MiSans","Microsoft YaHei",sans-serif;
    font-size:15px;line-height:1.75;font-variant-numeric:tabular-nums;}
  a{color:var(--accent);text-decoration:none;border-bottom:1px solid var(--accent-line);}
  a:hover{color:var(--accent-deep);border-bottom-color:var(--accent-deep);}
  /* ===================== 顶部极简导航条 ===================== */
  .topbar{position:fixed;top:0;left:0;right:0;z-index:30;
    background:rgba(255,255,255,.88);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
    border-bottom:1px solid var(--hair);}
  .topbar-in{max-width:1080px;margin:0 auto;display:flex;align-items:center;gap:10px;
    padding:10px 20px;min-height:46px;}
  .brand{display:flex;align-items:center;gap:9px;min-width:0;}
  .brand .mark{width:26px;height:26px;border-radius:8px;background:var(--blue-600);flex:none;
    display:flex;align-items:center;justify-content:center;}
  .brand .mark svg{display:block}
  .tb-name{font-size:14.5px;font-weight:700;color:var(--ink);white-space:nowrap;
    overflow:hidden;text-overflow:ellipsis;}
  .tb-badge{margin-left:auto;flex:none;display:inline-block;border:1px solid var(--hair2);
    border-radius:999px;padding:2px 11px;font-size:12px;color:var(--blue-800);background:var(--blue-50);}
  .tb-progress{height:2px;background:transparent;}
  .tb-progress i{display:block;height:100%;width:0;background:var(--blue-600);
    transition:width .3s ease;border-radius:0 2px 2px 0;}
  /* ===================== 卡片轮播容器（scroll-snap） ===================== */
  .deck{position:fixed;inset:0;display:flex;overflow-x:auto;overflow-y:hidden;
    scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;
    -webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;}
  .deck::-webkit-scrollbar{display:none}
  .card{flex:0 0 100vw;width:100vw;height:100vh;height:100dvh;overflow-y:auto;
    overflow-x:hidden;scroll-snap-align:start;scroll-snap-stop:always;
    -webkit-overflow-scrolling:touch;}
  .card-in{max-width:880px;margin:0 auto;padding:84px 28px 118px;}
  .c-kicker{display:flex;align-items:center;gap:10px;margin:0 0 10px;
    font-size:12px;font-weight:600;letter-spacing:.14em;color:var(--muted);}
  .c-kicker b{font-weight:700;color:var(--accent);letter-spacing:.05em;}
  .c-title{font-size:24px;font-weight:700;margin:0 0 6px;line-height:1.4;letter-spacing:.01em;}
  .c-note{font-size:12.5px;color:var(--muted);margin:0 0 22px;}
  .blk-title{font-size:15px;font-weight:700;margin:30px 0 10px;color:var(--ink);}
  .card-cover .c-title{font-size:36px;line-height:1.25;margin-top:2px;}
  .cover-sub{color:var(--muted);font-size:13.5px;margin:0 0 24px;}
  /* 结论区：评分环 + 风险等级 + 一句话结论 */
  .scoreline{display:flex;flex-wrap:wrap;align-items:center;gap:22px;
    background:var(--card);border:1px solid var(--hair);border-radius:var(--r-card);
    box-shadow:var(--shadow-md);padding:20px 24px;}
  .ring{--c:var(--red);width:106px;height:106px;border-radius:50%;flex:none;
    background:conic-gradient(var(--c) calc(var(--p)*1%), var(--blue-100) 0);
    display:flex;align-items:center;justify-content:center;position:relative;}
  .ring::after{content:"";position:absolute;inset:10px;background:var(--card);border-radius:50%;}
  .ring i{position:relative;font-style:normal;font-size:34px;font-weight:700;
    letter-spacing:-.01em;color:var(--c);line-height:1;}
  .ring i small{display:block;font-size:11px;font-weight:400;color:var(--muted);
    letter-spacing:.06em;margin-top:3px;text-align:center;}
  .ring.hi{--c:var(--red)} .ring.mid{--c:var(--orange)} .ring.low{--c:var(--yellow)}
  .score-side{flex:1;min-width:220px;}
  .lvl{display:inline-block;border-radius:999px;padding:2px 13px;font-size:13.5px;font-weight:600;}
  .lvl.hi{color:var(--red-t);border:1px solid #efc4bd;background:var(--red-bg);}
  .lvl.mid{color:var(--orange-t);border:1px solid #f0d2ac;background:var(--orange-bg);}
  .lvl.low{color:var(--yellow-t);border:1px solid #e8dca6;background:var(--yellow-bg);}
  .verdict{font-size:16.5px;font-weight:600;line-height:1.8;margin:12px 0 0;}
  .verdict .vl{color:var(--muted);font-weight:400;font-size:13px;margin-right:6px;}
  /* 八维横条：类别名 + 横向条 + 分数，无任何标签堆砌；条宽由 --w 驱动，翻到本卡时 JS 从 0 过渡 */
  .dim{display:grid;grid-template-columns:96px 1fr 40px;gap:10px 14px;align-items:center;
    padding:8px 0;border-bottom:1px solid var(--hair);}
  .dim:last-of-type{border-bottom:0}
  .dim .name{font-size:14px;color:var(--ink);}
  .bar{background:var(--blue-50);border-radius:999px;height:9px;position:relative;overflow:hidden;}
  .bar i{position:absolute;left:0;top:0;bottom:0;border-radius:999px;width:var(--w,0%);
    transition:width .7s cubic-bezier(.25,.46,.35,1);}
  .bar i.hi{background:var(--red)} .bar i.mid{background:var(--orange)} .bar i.low{background:var(--yellow)}
  .bar i.none{background:var(--blue-200)}
  .dim .val{font-size:13.5px;color:var(--muted);text-align:right;font-weight:600;}
  /* 八维归因小字：reason 缺失时不渲染，不占位 */
  .dim-reason{grid-column:1/-1;font-size:12px;color:var(--muted);line-height:1.6;
    margin-top:-3px;padding-bottom:2px;}
  .dim-ev{grid-column:1/-1;font-size:12px;color:var(--muted);margin-top:-4px;padding-bottom:2px;}
  .dim-ev a{display:inline-block;max-width:10em;white-space:nowrap;overflow:hidden;
    text-overflow:ellipsis;vertical-align:bottom;}
  .legend{font-size:12px;color:var(--muted);margin-top:12px;}
  .legend i{display:inline-block;width:9px;height:9px;border-radius:3px;margin:0 4px 0 10px;vertical-align:-1px;}
  /* 要点速览（结论卡） */
  .hl-list{list-style:none;margin:0;padding:0;}
  .hl-list li{display:flex;align-items:baseline;gap:10px;padding:10px 0;
    border-bottom:1px solid var(--hair);font-size:15px;margin:0;}
  .hl-list li:last-child{border-bottom:0}
  .hl-list li::before{content:"";flex:none;width:8px;height:8px;border-radius:50%;
    align-self:center;background:var(--yellow);}
  .hl-list li.sev-high::before{background:var(--red)}
  .hl-list li.sev-medium::before{background:var(--orange)}
  .hl-list li.sev-low::before{background:var(--yellow)}
  .hl-list a{font-weight:600;}
  .hl-sub{margin-left:auto;flex:none;font-size:12.5px;color:var(--muted);
    max-width:46%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .page-hint{margin-top:34px;font-size:12.5px;color:var(--muted);text-align:center;}
  /* 关键发现：一句风险标题 + 左侧严重度色条 + 两行摘要 + 上标引用编号（点跳卡底来源） */
  .finding{background:var(--card);border:1px solid var(--hair);border-left:4px solid var(--yellow);
    border-radius:var(--r-card);box-shadow:var(--shadow-sm);padding:16px 20px;margin-bottom:14px;}
  .finding.sev-high{border-left-color:var(--red);}
  .finding.sev-medium{border-left-color:var(--orange);}
  .finding.sev-low{border-left-color:var(--yellow);}
  .f-risk{font-size:16.5px;font-weight:700;margin:0;line-height:1.55;}
  .f-risk .cite{font-size:11px;font-weight:600;line-height:1;vertical-align:super;
    margin-left:3px;border-bottom:0;padding:2px;}
  .f-meta{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--muted);margin:3px 0 0;}
  .f-meta::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--yellow);flex:none;}
  .finding.sev-high .f-meta::before{background:var(--red)}
  .finding.sev-medium .f-meta::before{background:var(--orange)}
  .finding.sev-low .f-meta::before{background:var(--yellow)}
  .f-meta .sep{color:var(--hair2);margin:0 2px;}
  .f-sum{margin:8px 0 0;font-size:14.5px;
    display:-webkit-box;-webkit-line-clamp:2;line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  /* 卡底来源紧凑列表：编号 + 平台 + 日期 + ↗，引文一行小字 */
  .src-list{list-style:none;margin:0;padding:0;}
  .src-item{padding:7px 0;border-bottom:1px solid var(--hair);scroll-margin-top:78px;}
  .src-item:last-child{border-bottom:0}
  .src-line{margin:0;font-size:13px;line-height:1.6;}
  .src-no{color:var(--muted);font-weight:600;font-variant-numeric:tabular-nums;margin-right:4px;}
  .src-line .no-url{color:var(--muted);}
  .src-line a{color:var(--blue-800);}
  .src-q{margin:2px 0 0 26px;font-size:12px;color:var(--muted);line-height:1.6;
    border-left:2px solid var(--blue-100);padding-left:8px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .l-title a,.src-line a{word-break:break-all;}
  ol.sug{padding-left:22px;margin:10px 0 0;}
  ol.sug li{margin-bottom:8px;font-size:14.5px;}
  /* 口碑好评 */
  .pos-list{list-style:none;margin:0;padding:0;}
  .pos-list li{display:flex;gap:12px;align-items:flex-start;padding:13px 0;
    border-bottom:1px solid var(--hair);font-size:15px;line-height:1.8;margin:0;}
  .pos-list li:last-child{border-bottom:0}
  .pos-list svg{flex:none;margin-top:6px;color:var(--blue-600);}
  /* 好评扩容（8-10 条）：紧凑样式 + 容器内滚动，与风险侧视觉对称 */
  .pos-scroll.tall{max-height:min(64vh,620px);overflow-y:auto;padding-right:6px;}
  .pos-list.compact li{padding:8px 0;font-size:13.5px;line-height:1.65;}
  .pos-list.compact svg{margin-top:4px;width:14px;height:14px;}
  /* FAQ 行动清单：勾选框样式 */
  .chk-list{list-style:none;margin:0;padding:0;}
  .chk-list li{display:flex;gap:11px;align-items:flex-start;padding:10px 0;
    border-bottom:1px solid var(--hair);font-size:14.5px;line-height:1.7;margin:0;}
  .chk-list li:last-child{border-bottom:0}
  .chk-list li::before{content:"";flex:none;width:15px;height:15px;margin-top:5px;
    border:1.6px solid var(--blue-600);border-radius:4px;background:var(--blue-50);}
  /* 房源卡片网格 */
  .l-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px;margin-top:4px;}
  .listing{background:var(--card);border:1px solid var(--hair);border-radius:var(--r-card);
    box-shadow:var(--shadow-sm);padding:14px 16px;margin:0;}
  .l-title{font-size:15px;font-weight:600;margin:0;line-height:1.6;}
  .l-price{color:var(--blue-800);font-weight:700;font-size:16px;margin:6px 0 0;}
  .l-meta{display:flex;flex-wrap:wrap;gap:4px 12px;font-size:12.5px;color:var(--muted);margin-top:4px;}
  /* 候选对比：对齐的定义行，不用横向滚动表格 */
  .cand{background:var(--card);border:1px solid var(--hair);border-radius:var(--r-card);
    box-shadow:var(--shadow-sm);padding:16px 20px;margin-bottom:12px;}
  .cand:last-child{margin-bottom:0}
  .cand-name{font-size:16px;font-weight:700;margin:0 0 8px;}
  .cand-row{display:grid;grid-template-columns:64px 1fr;gap:12px;align-items:baseline;
    padding:5px 0;font-size:14px;}
  .cand-row dt{color:var(--muted);font-size:13px;}
  .cand-row dd{margin:0;line-height:1.7;word-break:break-word;overflow:visible;}
  /* 候选来源线索小字：不截断，完整展示 */
  .cand-ev{margin:6px 0 0;font-size:12px;color:var(--muted);line-height:1.65;
    border-left:2px solid var(--blue-100);padding-left:8px;}
  /* 配套地图卡 */
  .geo-loc{font-size:13px;color:var(--muted);margin:0 0 14px;}
  .map-box{height:340px;border:1px solid var(--hair);border-radius:var(--r-card);
    background:var(--blue-50);overflow:hidden;}
  .map-fallback{font-size:13px;color:var(--muted);border:1px dashed var(--hair2);
    border-radius:var(--r-ctl);padding:10px 12px;margin:0;background:var(--card);}
  .amap-home{background:var(--blue-600);border:1px solid var(--blue-800);color:#fff;
    font-size:12px;line-height:1;padding:5px 8px;border-radius:999px;white-space:nowrap;}
  .route-box{border:1px solid var(--hair);border-radius:var(--r-card);background:var(--card);
    box-shadow:var(--shadow-sm);padding:12px 16px;margin:16px 0 0;}
  .route-line{font-size:14.5px;font-weight:600;margin:0;}
  .route-line .sep{color:var(--hair2);margin:0 6px;font-weight:400;}
  .route-sum{font-size:12.5px;color:var(--muted);margin:8px 0 0;line-height:1.65;}
  /* 配套对齐网格：图标 | 名称 | 距离 三列严格对齐 */
  .am-groups{display:grid;grid-template-columns:1fr 1fr;gap:6px 30px;margin-top:20px;}
  .am-group{min-width:0;}
  .am-gh{display:flex;align-items:center;gap:8px;font-size:13.5px;font-weight:700;
    color:var(--ink);padding:8px 0 4px;border-bottom:2px solid var(--hair2);}
  .am-gh svg{color:var(--blue-600);flex:none;}
  .am-row{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:baseline;
    padding:7px 0 7px 2px;border-bottom:1px solid var(--hair);}
  .am-row:last-child{border-bottom:0}
  .am-name{font-size:13.5px;color:var(--ink);min-width:0;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .am-dist{font-size:12.5px;color:var(--muted);text-align:right;white-space:nowrap;}
  .geo-none-txt{font-size:13px;color:var(--muted);margin:14px 0 0;}
  /* 数据说明卡 */
  .d-badges{display:flex;flex-wrap:wrap;gap:8px 10px;margin:0 0 16px;}
  .badge{display:inline-block;border:1px solid var(--hair2);border-radius:999px;
    padding:2px 11px;font-size:12px;color:var(--blue-800);background:var(--blue-50);}
  .d-note{font-size:13px;color:var(--muted);margin:0 0 10px;}
  .d-stat{font-size:13px;color:var(--ink);margin:0 0 6px;}
  .d-disc{background:var(--card);border:1px solid var(--hair);border-radius:var(--r-ctl);
    box-shadow:var(--shadow-sm);padding:12px 16px;font-size:13px;color:var(--muted);
    margin:16px 0 0;line-height:1.8;}
  .d-disc strong{color:var(--ink);}
  .d-time{font-size:12.5px;color:var(--muted);margin:12px 0 0;}
  .d-raw{margin-top:16px;border:1px dashed var(--hair2);border-radius:var(--r-ctl);
    padding:10px 14px;font-size:12.5px;color:var(--muted);}
  .d-raw summary{cursor:pointer;color:var(--accent);font-weight:600;font-size:13px;}
  .d-raw p{margin:8px 0 0;line-height:1.8;}
  /* ===================== 底部翻页导航 ===================== */
  .deck-nav{position:fixed;bottom:0;left:0;right:0;z-index:30;display:flex;
    align-items:center;justify-content:center;gap:14px;
    padding:14px 16px calc(14px + env(safe-area-inset-bottom,0px));
    background:linear-gradient(rgba(243,247,252,0), rgba(243,247,252,.92) 40%);
    pointer-events:none;}
  .deck-nav > *{pointer-events:auto}
  .deck-nav.single{display:none}
  .dots{display:flex;align-items:center;gap:7px;}
  .dot{width:8px;height:8px;border-radius:999px;border:0;padding:0;cursor:pointer;
    background:var(--blue-200);transition:width .25s ease,background .25s ease;}
  .dot.on{width:22px;background:var(--blue-600);}
  .page-no{font-size:12.5px;color:var(--muted);font-variant-numeric:tabular-nums;
    min-width:34px;text-align:center;}
  .nav-btn{display:none;width:38px;height:38px;border-radius:50%;border:1px solid var(--hair2);
    background:var(--card);color:var(--blue-800);font-size:16px;line-height:1;cursor:pointer;
    align-items:center;justify-content:center;box-shadow:var(--shadow-sm);}
  .nav-btn:hover{background:var(--blue-50);}
  .nav-btn:disabled{opacity:.35;cursor:default;}
  @media (hover:hover) and (pointer:fine){ .nav-btn{display:flex} }
  /* ===================== 底部楼群装饰（昼/夜双态） ===================== */
  .city-scene{display:flex;justify-content:center;margin-top:36px;pointer-events:none;
    border-radius:12px;padding:8px 0 0;}
  .city-scene svg{display:block;width:min(320px,80%);height:auto;}
  .city-scene.night{background:linear-gradient(180deg,#2b3c5c 0%,#22314d 100%);}
  .cs-sun{fill:#f6c760}
  .cs-rays{stroke:#f6c760}
  .cs-ground{fill:#c4d8f0}
  .cs-b1{fill:#dce9f9} .cs-b2{fill:#c4d8f0} .cs-b3{fill:#1f5fbf} .cs-b4{fill:#e8eff9} .cs-b5{fill:#dce9f9}
  .cs-ground{stroke:#c4d8f0}
  .city-scene.night .cs-sun{fill:#e9eef7}
  .city-scene.night .cs-rays{stroke:#e9eef7;opacity:.5}
  .city-scene.night .cs-b1{fill:#3a4c6d} .city-scene.night .cs-b2{fill:#334565}
  .city-scene.night .cs-b3{fill:#27395a} .city-scene.night .cs-b4{fill:#3a4c6d}
  .city-scene.night .cs-b5{fill:#334565}
  .city-scene.night .cs-ground{fill:#334565}
  .city-scene.night .cs-win{fill:#f6c760}
  .cs-float{animation:cs-float 5s ease-in-out infinite alternate;transform-origin:50% 100%;}
  .cs-cloud{animation:cs-drift 30s linear infinite;}
  .cs-win{animation:cs-win 3s ease-in-out infinite;}
  .cs-win:nth-of-type(2n){animation-duration:2.6s;animation-delay:-1.1s;}
  .cs-win:nth-of-type(3n){animation-duration:3.8s;animation-delay:-2s;}
  .cs-car{animation:cs-car 9s linear infinite;}
  @keyframes cs-float{from{transform:translateY(0)}to{transform:translateY(-7px)}}
  @keyframes cs-drift{from{transform:translateX(-40px)}to{transform:translateX(360px)}}
  @keyframes cs-win{0%,100%{opacity:.18}50%{opacity:1}}
  @keyframes cs-car{from{transform:translateX(-70px)}to{transform:translateX(350px)}}
  @media (prefers-reduced-motion:reduce){
    .cs-float,.cs-cloud,.cs-win,.cs-car{animation:none !important}
    .cs-win{opacity:.85}
    .bar i{transition:none !important}
    .deck{scroll-behavior:auto}
  }
  /* ===================== 手机端（<768px） ===================== */
  @media (max-width:768px){
    .card-in{padding:74px 18px 112px;}
    @supports (padding:max(0px)){
      .card-in{padding-left:max(18px,env(safe-area-inset-left,0px));
               padding-right:max(18px,env(safe-area-inset-right,0px));}
    }
    .card-cover .c-title{font-size:28px;}
    .c-title{font-size:20px;}
    .scoreline{padding:16px 16px;gap:16px;}
    .ring{width:92px;height:92px;}
    .ring i{font-size:28px;}
    .verdict{font-size:15.5px;}
    .map-box{height:250px;}
    .am-groups{grid-template-columns:1fr;gap:4px;}
    .cand-row{grid-template-columns:52px 1fr;gap:10px;}
    .hl-sub{display:none}
    /* 触屏：来源/房源链接点击区抬高 */
    .src-line a,.dim-ev a,.l-title a{display:inline-block;min-height:34px;
      padding:8px 2px;line-height:1.4;vertical-align:middle;}
    .dim{grid-template-columns:80px 1fr 36px;gap:8px 10px;padding:10px 0;}
    .dim-ev{margin-top:0;}
    .d-disc{font-size:12.5px;}
  }
  @media (max-width:480px){
    .dim{grid-template-columns:1fr 40px;
      grid-template-areas:"name val" "bar bar" "ev ev";}
    .dim .name{grid-area:name;}
    .dim .val{grid-area:val;}
    .dim .bar{grid-area:bar;margin:6px 0 2px;}
    .dim-ev{grid-area:ev;margin-top:4px;}
    .l-grid{grid-template-columns:1fr;}
  }
  /* ===================== 打印：每卡一页 ===================== */
  @media print{
    body{overflow:visible;background:#fff;}
    .topbar,.deck-nav,.page-hint{display:none !important;}
    .deck{position:static;display:block;overflow:visible;scroll-snap-type:none;}
    .card{width:auto;height:auto;flex:none;overflow:visible;page-break-after:always;}
    .card-in{padding:24px;}
  }
</style>
</head>
<body class="tier-{{ overall_tier if overall_tier is defined else 'none' }}">
{# ===================== 组件定义 ===================== #}
{% set mode_names = {"diligence":"尽调避坑报告","recommend":"推荐评价报告","locate":"选址对比报告","listings":"转租房源汇总","faq":"租房答疑报告"} %}
{# 风险分档 class：>=60 hi / >=30 mid / 其余 low #}
{% macro score_cls(s) %}{{ "hi" if s >= 60 else ("mid" if s >= 30 else "low") }}{% endmacro %}
{# 通勤守卫：仅当 analysis 的 coverage.note 明确写了「通勤目的地：」（即用户提供）才渲染通勤块与画线 #}
{% set show_commute = geo is defined and geo and geo.route and coverage_note is defined and coverage_note and ("通勤目的地：" in coverage_note) %}
{% set ns = namespace(n=0) %}

{# 全屏卡片外壳：序号自动累加，卡内纵向滚动 #}
{% macro card(num, kicker, title, cid) %}
<section class="card{% if cid == 'cover' %} card-cover{% endif %}" id="card-{{ cid }}">
  <div class="card-in">
    <p class="c-kicker"><b>{{ "%02d"|format(num) }}</b>{{ kicker }}</p>
    <h2 class="c-title">{{ title }}</h2>
    {{ caller() }}
  </div>
</section>
{% endmacro %}

{# 配套图标：按组名匹配，未命中落回定位针 #}
{% macro am_icon(group) -%}
{% set g = group ~ "" -%}
<span class="am-gh-ico" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
{%- if "地铁" in g -%}
<rect x="3.5" y="2" width="9" height="9" rx="2.5"/><path d="M5.5 13.5 7 11M10.5 13.5 9 11M5.5 6h5"/>
{%- elif "公交" in g -%}
<rect x="2.5" y="3" width="11" height="8" rx="2"/><path d="M2.5 8h11M5.5 11v1.8M10.5 11v1.8"/>
{%- elif "超市" in g or "便利" in g or "商场" in g or "购物" in g -%}
<path d="M3.5 5.5h9l-.8 8H4.3z"/><path d="M5.5 5.5V4a2.5 2.5 0 0 1 5 0v1.5"/>
{%- elif "医院" in g or "诊所" in g or "口腔" in g or "卫生" in g -%}
<circle cx="8" cy="8" r="5.5"/><path d="M8 5.5v5M5.5 8h5"/>
{%- elif "药" in g -%}
<rect x="3" y="5.5" width="10" height="5" rx="2.5"/><path d="M8 5.5v5"/>
{%- elif "学" in g or "校" in g or "幼" in g -%}
<path d="M8 3.5 13.5 6 8 8.5 2.5 6z"/><path d="M5.5 7.5V10c0 .8 1.1 1.5 2.5 1.5s2.5-.7 2.5-1.5V7.5"/>
{%- elif "公园" in g or "园林" in g or "广场" in g -%}
<path d="M8 2.5 11 7H5z"/><path d="M9.2 7 12 11H4l2.8-4"/><path d="M8 11v2.5"/>
{%- elif "餐" in g or "吃" in g or "饭" in g or "咖啡" in g -%}
<path d="M3.5 6.5h9c0 3-2 4.5-4.5 4.5s-4.5-1.5-4.5-4.5z"/><path d="M5 13h6"/>
{%- else -%}
<path d="M8 13.5C5 10.5 3.5 8.6 3.5 6.5a4.5 4.5 0 0 1 9 0c0 2.1-1.5 4-4.5 7z"/><circle cx="8" cy="6.5" r="1.6"/>
{%- endif -%}
</svg></span>
{%- endmacro %}

{# 统一空值占位：空串/None/N/A 一律显示「暂无」，防中英混排 #}
{% macro val(v, unit='') %}{{ (v ~ unit) if v not in [None, '', 'N/A'] else '暂无' }}{% endmacro %}

{# 发布时间紧凑展示：YYYY-MM-DD，非日期原样；供发现来源与房源卡共用 #}
{% macro pub_short(p) %}{{ p[:10] if p and p|length >= 10 and p[4:5] == '-' else (p or '') }}{% endmacro %}

{# 距离格式化 #}
{% macro dist_txt(m) %}{{ '%.1f'|format(m / 1000) if m >= 1000 else m }}{% if m >= 1000 %} 公里{% else %} 米{% endif %}{% endmacro %}

{# 底部楼群装饰：JS 按本地时间 18:00-6:00 加 night 类切夜景（窗灯暖黄） #}
{% macro city_scene() %}
<div class="city-scene" aria-hidden="true">
