{% endmacro %}

{# ===================== 顶部导航条 ===================== #}
<header class="topbar">
  <div class="topbar-in">
    <div class="brand">
      <span class="mark" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
          <path d="M2 14V7l4-3v10M6 14V4l5 2.5V14" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M11 14V6.5L14 8v6" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="tb-name">{{ target_name }}</span>
    </div>
    <span class="tb-badge">{{ mode_names.get(mode, "租房参考报告") }}</span>
  </div>
  <div class="tb-progress" aria-hidden="true"><i id="deck-progress"></i></div>
</header>

{# ===================== 卡片轮播 ===================== #}
<main class="deck mode-{{ mode }}" id="deck">

  {# ---- 卡 1：结论 ---- #}
  {% if mode != "faq" %}
  {% set ns.n = ns.n + 1 %}
  {% call card(ns.n, mode_names.get(mode, "租房参考报告"), target_name, "cover") %}
  <p class="cover-sub">{% if target_city %}{{ target_city }} · {% endif %}{% if target_type %}{{ target_type }} · {% endif %}生成于 {{ rendered_at }}</p>

  {% if mode in ["diligence","recommend"] %}
  <div class="scoreline">
    <span class="ring {{ score_cls(overall_score) }}" style="--p:{{ overall_score }}" data-p="{{ overall_score }}"><i><span data-count="{{ overall_score }}">{{ overall_score }}</span><small>风险分</small></i></span>
    <div class="score-side">
      <span class="lvl {{ score_cls(overall_score) }}">风险等级：{{ risk_level }}</span>
      {% if verdict %}<p class="verdict"><span class="vl">结论</span>{{ verdict }}</p>
      {% else %}<p class="verdict">综合风险评分 {{ overall_score }}。无数据不等于安全，公开舆情未覆盖不代表无风险。</p>{% endif %}
    </div>
  </div>
  {% elif verdict %}
  <p class="verdict"><span class="vl">结论</span>{{ verdict }}</p>
  {% endif %}

  {% if dimensions %}
  <h3 class="blk-title">八维风险评分</h3>
  {% for d in dimensions %}
  <div class="dim">
    <span class="name">{{ d.name }}</span>
    <span class="bar"><i class="{{ d.tier }}" style="--w:{{ d.score }}%"></i></span>
    <span class="val" data-count="{{ d.score }}">{{ d.score }}</span>
    {% if d.reason %}<div class="dim-reason" title="{{ d.reason }}">{{ d.reason }}</div>{% endif %}
    {% if d.evidences %}<div class="dim-ev">来源：
      {% for e in d.evidences[:3] %}{% if e.url %}<a href="{{ e.url }}" target="_blank" rel="noopener noreferrer" title="{{ e.title }}">{{ e.title|nohash or "原帖" }}</a>{% else %}<span title="{{ e.title }}">{{ e.title|nohash or "原帖" }}</span>{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}
    </div>{% endif %}
  </div>
  {% endfor %}
  <p class="legend">图例：<i style="background:var(--red)"></i>高风险（≥60）<i style="background:var(--orange)"></i>中风险（30-59）<i style="background:var(--yellow)"></i>低风险（&lt;30）<i style="background:#c9c4b7"></i>无数据</p>
  {% endif %}

  {% if mode in ["diligence","recommend"] and findings %}
  <h3 class="blk-title">要点</h3>
  <ol class="hl-list">
    {% for f in findings[:3] %}
    <li class="sev-{{ f.severity }}"><a href="#card-findings">{{ f.risk }}</a><span class="hl-sub">严重度 {{ f.severity_label }}</span></li>
    {% endfor %}
  </ol>
  {% elif mode == "locate" and candidates %}
  <h3 class="blk-title">候选速览</h3>
  <ol class="hl-list">
    {% for c in candidates[:3] %}
    <li class="sev-low"><span>{{ c.name }}</span><span class="hl-sub">{{ c.commute }}</span></li>
    {% endfor %}
  </ol>
  {% elif mode == "listings" and listings %}
  <h3 class="blk-title">最新线索</h3>
  <ol class="hl-list">
    {% for l in listings[:2] %}
    <li class="sev-low"><span>{{ l.title|nohash or "房源帖" }}</span><span class="hl-sub">{{ l.price_hint }}</span></li>
    {% endfor %}
  </ol>
  {% endif %}

  <p class="page-hint">← → 键盘翻页 · 触屏左右滑动</p>
  {% endcall %}

  {# ---- 卡 2：关键发现（尽调族 diligence/recommend） ---- #}
  {% if mode in ["diligence","recommend"] %}
  {% set ns.n = ns.n + 1 %}
  {% call card(ns.n, "按严重度与置信度排序", "关键发现", "findings") %}
  <p class="c-note">每条发现后的上标编号可点，跳到本卡底部来源列表；引文摘自公开帖子，可能含主观表述。</p>
  {% if findings %}
  {# 展平编号：全部 evidence 统一连续编号，上标引用与卡底来源列表共用一套编号 #}
  {% set ns_cite = namespace(all=[], n=0) %}
  {% for f in findings %}{% set fi = loop.index0 %}{% for e in f.evidence %}
  {% set ns_cite.n = ns_cite.n + 1 %}
  {% set ns_cite.all = ns_cite.all + [{"i": ns_cite.n, "f": fi, "e": e}] %}
  {% endfor %}{% endfor %}
  {% for f in findings %}{% set fi = loop.index0 %}
  <article class="finding sev-{{ f.severity }}">
    <p class="f-risk">{{ f.risk }}{% for c in ns_cite.all if c.f == fi %}<a class="cite" href="#src-{{ c.i }}" aria-label="查看来源 {{ c.i }}">[{{ c.i }}]</a>{% endfor %}</p>
    <p class="f-meta">严重度 {{ f.severity_label }}<span class="sep">·</span>置信度 {{ f.confidence_label }}</p>
    {% if f.summary %}<p class="f-sum">{{ f.summary }}</p>{% endif %}
  </article>
  {% endfor %}
  {% if ns_cite.all %}
  <h3 class="blk-title" id="findings-srcs">来源（{{ ns_cite.all|length }}）</h3>
  <ol class="src-list">
    {% for c in ns_cite.all %}{% set e = c.e %}
    {% set pub = e.published_at or "" %}
    {% set pub_show = pub_short(pub) %}
    {% set pub_year = pub[:4]|int %}
    {% set q_show = e.quote|nohash %}
    <li class="src-item" id="src-{{ c.i }}" title="{{ e.title }}{% if e.quote %} {{ e.quote }}{% endif %}">
      <p class="src-line"><span class="src-no">[{{ c.i }}]</span>{% if e.url %}<a href="{{ e.url }}" target="_blank" rel="noopener noreferrer" title="{{ e.platform_label }}{% if pub %} · 发布于 {{ pub }}{% endif %}">{{ e.platform_label }} · {{ pub_show if pub_show else "暂无" }}{% if pub_year >= 2000 and rendered_at[:4]|int - pub_year >= 2 %} · 较早{% endif %} ↗</a>{% else %}<span class="no-url" title="{{ e.platform_label }}{% if pub %} · 发布于 {{ pub }}{% endif %}">{{ e.platform_label }} · {{ pub_show if pub_show else "暂无" }}</span>{% endif %}</p>
      {% if q_show %}<p class="src-q" title="{{ e.quote }}">{{ q_show }}</p>{% endif %}
    </li>
    {% endfor %}
  </ol>
  {% endif %}
  {% else %}
  <p class="c-note">未发现可归档的风险发现。无数据不等于安全，公开舆情未覆盖不代表无风险。</p>
  {% endif %}
  {% if suggestions %}
  <h3 class="blk-title">租前核验建议</h3>
  <ol class="sug">
    {% for s in suggestions %}<li>{{ s }}</li>{% endfor %}
  </ol>
  {% endif %}
  {% endcall %}
  {% endif %}

  {# ---- 卡 3：房源 / 价格（listings 主体，recommend 线索） ---- #}
  {% if mode in ["listings", "locate"] or (mode in ["diligence","recommend"] and listings) %}
  {% set ns.n = ns.n + 1 %}
  {% call card(ns.n, "公开平台聚合 · 真实性未核验", "候选房源" if mode == "listings" else "在租房源线索", "listings") %}
  {% if mode == "listings" %}
  <p class="c-note">以下为公开平台聚合的转租/直租信息，仅作展示，真实性未核验；超过 30 天的帖子信息可能已过期。</p>
  {% else %}
  <p class="c-note">公开平台聚合的转租/直租信息，真实性未核验，联系前按建议核身。</p>
  {% endif %}
  {% if listings %}
  <div class="l-grid">
    {% for l in listings %}
    <article class="listing">
      {% if l.url %}<p class="l-title"><a href="{{ l.url }}" target="_blank" rel="noopener noreferrer" title="{{ l.title }}">{{ l.title|nohash or "房源帖" }}</a></p>
      {% else %}<p class="l-title" title="{{ l.title }}">{{ l.title|nohash or "房源帖" }}</p>{% endif %}
      {% if l.price_hint %}<p class="l-price">{{ val(l.price_hint) }}</p>{% endif %}
      <div class="l-meta">
        {% if l.room_hint %}<span>{{ l.room_hint|join(" · ") }}</span>{% endif %}
        <span>{{ val(l.platform_label) }}</span>
        {% if l.published_at %}<span title="发布于 {{ l.published_at }}">发布：{{ pub_short(l.published_at) }}</span>{% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <p class="c-note">本轮清洗数据中未识别出房源帖。</p>
  {% endif %}
  {% if mode == "listings" and suggestions %}
  <h3 class="blk-title">联系前必读</h3>
  <ol class="sug">
    {% for s in suggestions %}<li>{{ s }}</li>{% endfor %}
  </ol>
  {% endif %}
  {% endcall %}
  {% endif %}

  {# ---- 卡 4：口碑好评 ---- #}
  {% if positive %}
  {% set ns.n = ns.n + 1 %}
  {% call card(ns.n, "来自公开帖子的真实评价", "住客好评点", "positive") %}
  {% set pos_long = positive|length > 6 %}
  <div class="pos-scroll{% if pos_long %} tall{% endif %}">
  <ul class="pos-list{% if pos_long %} compact{% endif %}">
    {% for p in positive %}
    <li><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3 3 7-7"/></svg><span title="{{ p }}">{{ p|nohash }}</span></li>
    {% endfor %}
  </ul>
  </div>
  {% endcall %}
  {% endif %}

  {# ---- 卡 5：候选对比（locate 主体 / recommend 补充） ---- #}
  {% if mode == "locate" or (mode == "recommend" and candidates) %}
  {% set ns.n = ns.n + 1 %}
  {% call card(ns.n, "口碑摘要来自公开帖子", "候选片区对比" if mode == "locate" else "候选对比", "candidates") %}
  {% if mode == "locate" %}
  <p class="c-note">候选片区基于预算与通勤的经验推断，口碑摘要来自公开帖子，通勤为文本估算；建议实地看房核实。</p>
  {% else %}
  <p class="c-note">口碑摘要来自公开帖子；通勤为文本估算，建议实地看房核实。</p>
  {% endif %}
  {% if candidates %}
  {% for c in candidates %}
  <article class="cand">
    <p class="cand-name">{{ c.name }}</p>
    <dl>
      <div class="cand-row"><dt>优点</dt><dd>{{ val(c.pros) }}</dd></div>
      <div class="cand-row"><dt>短板</dt><dd>{{ val(c.cons) }}</dd></div>
      <div class="cand-row"><dt>通勤</dt><dd>{{ val(c.commute) }}</dd></div>
    </dl>
    {% if c.evidence %}<p class="cand-ev" title="{{ c.evidence }}">来源线索：{{ c.evidence }}</p>{% endif %}
  </article>
  {% endfor %}
  {% else %}
  <p class="c-note">暂无候选片区数据。</p>
  {% endif %}
  {% if mode == "locate" and suggestions %}
  <h3 class="blk-title">下一步建议</h3>
  <ol class="sug">
    {% for s in suggestions %}<li>{{ s }}</li>{% endfor %}
  </ol>
  {% endif %}
  {% endcall %}
  {% endif %}

  {# ---- 卡 6：位置与配套（geo 存在时；通勤块仅当用户提供通勤目的地） ---- #}
  {% if geo and geo.usable %}
  {% set radius_km = (geo.around.radius_m / 1000)|round(1) %}
  {% set ns.n = ns.n + 1 %}
  {% call card(ns.n, "高德地图开放平台 · 估算数据", "位置与配套", "geo") %}
  <p class="geo-loc">
    定位：{{ geo.geocode.formatted_address or target_name }}（{{ geo.geocode.location }}）{% if radius_km %} · 周边检索半径 {{ radius_km }} 公里{% endif %}。距离与耗时为平台估算，请以实地为准。
  </p>
  {% if map_ready %}
  <div id="amap-box" class="map-box" role="img" aria-label="{{ target_name }}周边配套地图"></div>
  <p id="map-fallback" class="map-fallback" hidden>地图未能加载（可能离线或密钥不可用），周边信息以下方文字版为准。</p>
  {% else %}
  <p class="map-fallback">地图未启用（未配置 JSAPI 密钥），周边信息以下方文字版为准。</p>
  {% endif %}

  {% if show_commute %}
  <div class="route-box">
    <p class="route-line">通勤测算 · {{ geo.route.mode_label }}{% if geo.route.duration_min %}<span class="sep">·</span>约 {{ geo.route.duration_min }} 分钟{% endif %}{% if geo.route.distance_m %}<span class="sep">·</span>全程 {{ '%.1f'|format(geo.route.distance_m / 1000) }} 公里{% endif %}{% if geo.route.mode == "transit" %}<span class="sep">·</span>{{ ("换乘 " ~ geo.route.transfers ~ " 次") if geo.route.transfers else "无需换乘" }}{% endif %}</p>
    {% if geo.route.summary %}<p class="route-sum">{{ geo.route.summary }}</p>{% endif %}
  </div>
  {% endif %}

  {% if geo.around.groups %}
  <div class="am-groups">
    {% for gr in geo.around.groups %}
    <div class="am-group">
      <p class="am-gh">{{ am_icon(gr.group) }}{{ gr.group }}</p>
      {% for p in gr.pois %}
      <div class="am-row"><span class="am-name" title="{{ p.name }}">{{ p.name }}</span><span class="am-dist">{{ dist_txt(p.distance_m) }}</span></div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <p class="geo-none-txt">周边配套数据未采集。</p>
  {% endif %}
  {% endcall %}

  {% if map_ready %}
  <script>
  (function(){
    var GEO = {{ geo|tojson }};
    var KEY = {{ jsapi_key|tojson }};
    var SECRET = {{ jsapi_secret|tojson }};
    var LABEL = {{ target_name|tojson }};
    {% if not show_commute %}GEO.route = null; /* 壳层守卫：未确认用户提供的通勤目的地，不画通勤线 */{% endif %}
    var box = document.getElementById('amap-box');
    var fb = document.getElementById('map-fallback');
    function degrade(){
      if (box) box.hidden = true;
      if (fb) fb.hidden = false;
    }
    if (!box) return;
    if (SECRET) { window._AMapSecurityConfig = { securityJsCode: SECRET }; }
    function ll(loc){
      var p = String(loc || '').split(',');
      return [parseFloat(p[0]), parseFloat(p[1])];
    }
    var done = false;
    var guard = setTimeout(function(){ if (!done) degrade(); }, 10000);
    var s = document.createElement('script');
    s.src = 'https://webapi.amap.com/maps?v=2.0&key=' + encodeURIComponent(KEY);
    s.async = true;
    s.onerror = function(){ clearTimeout(guard); degrade(); };
    s.onload = function(){
      if (!window.AMap) { clearTimeout(guard); degrade(); return; }
      try {
        var g = GEO.geocode || {};
        var map = new AMap.Map(box, { zoom: 14, viewMode: '2D', center: ll(g.location) });
        map.on('error', function(){ done = true; clearTimeout(guard); degrade(); });
        var overlays = [];
        var home = new AMap.Marker({
          position: ll(g.location), anchor: 'bottom-center',
          content: '<div class="amap-home">' + String(LABEL).replace(/</g, '&lt;') + '</div>'
        });
        map.add(home); overlays.push(home);
        ((GEO.around && GEO.around.groups) || []).forEach(function(gr){
          (gr.pois || []).forEach(function(p){
            if (!p.location) return;
            var m = new AMap.CircleMarker({ center: ll(p.location), radius: 4,
              strokeColor: '#ffffff', strokeWeight: 1,
              fillColor: '#5b6b7d', fillOpacity: 1 });
            map.add(m); overlays.push(m);
          });
        });
        ((GEO.noise && GEO.noise.hits) || []).forEach(function(p){
          if (!p.location) return;
          var m = new AMap.CircleMarker({ center: ll(p.location), radius: 5,
            strokeColor: '#ffffff', strokeWeight: 1,
            fillColor: '#c0392b', fillOpacity: 0.95 });
          map.add(m); overlays.push(m);
        });
        var r = GEO.route;
        if (r && r.origin_location && r.dest_location) {
          var line = new AMap.Polyline({
            path: [ll(r.origin_location), ll(r.dest_location)],
            strokeColor: '#1f5fbf', strokeWeight: 2.5, strokeOpacity: 0.9,
            strokeStyle: 'dashed', strokeDashArray: [8, 6], lineJoin: 'round' });
          map.add(line); overlays.push(line);
          var dst = new AMap.CircleMarker({ center: ll(r.dest_location), radius: 6,
            strokeColor: '#1f5fbf', strokeWeight: 2,
            fillColor: '#ffffff', fillOpacity: 1 });
          map.add(dst); overlays.push(dst);
        }
        if (overlays.length) map.setFitView(overlays, false, [46, 46, 46, 46]);
        done = true; clearTimeout(guard);
        /* SCODE 失败时 JSAPI 可能只留下空白容器：延迟探测一次瓦片层 */
        setTimeout(function(){
          if (!box.querySelector('canvas') && !box.querySelector('.amap-layer') && !box.querySelector('img')) degrade();
        }, 8000);
      } catch (e) { clearTimeout(guard); degrade(); }
    };
    document.head.appendChild(s);
  })();
  </script>
  {% endif %}
  {% endif %}
  {% endif %}{# -- mode != "faq" 包裹结束 -- #}

  {# ---- FAQ 专属卡组：问题 / 分节要点 / 风险+行动清单 ---- #}
  {% if mode == "faq" %}
  {% set ns.n = ns.n + 1 %}
  {% call card(ns.n, "租房答疑", faq.question, "faq-cover") %}
  <p class="cover-sub">{% if faq.target_name %}{{ faq.target_name }} · {% endif %}生成于 {{ rendered_at }}</p>
  {% if verdict %}<p class="verdict"><span class="vl">导语</span>{{ verdict }}</p>{% endif %}
  <p class="page-hint">← → 键盘翻页 · 触屏左右滑动</p>
  {% endcall %}

  {% set ns.n = ns.n + 1 %}
  {% call card(ns.n, "分节要点", "答疑要点", "faq-sections") %}
  {% for s in faq.sections %}
  <h3 class="blk-title">{{ s.title }}</h3>
  <ol class="sug">
    {% for p in s.points %}<li>{{ p }}</li>{% endfor %}
  </ol>
  {% endfor %}
  {% endcall %}

  {% set ns.n = ns.n + 1 %}
  {% call card(ns.n, "风险提示与行动清单", "注意这些坑", "faq-actions") %}
  <h3 class="blk-title">风险提示</h3>
  <ol class="hl-list">
    {% for r in faq.risk_notes %}
    <li class="sev-high"><span title="{{ r }}">{{ r }}</span></li>
    {% endfor %}
  </ol>
  <h3 class="blk-title">行动清单</h3>
  <ul class="chk-list">
    {% for a in faq.action_checklist %}<li><span title="{{ a }}">{{ a }}</span></li>{% endfor %}
  </ul>
  {% endcall %}
  {% endif %}

  {# ---- 卡 7：数据说明（收尾） ---- #}
  {% set ns.n = ns.n + 1 %}
  {% call card(ns.n, "方法与免责声明", "数据说明", "data") %}
  <div class="d-badges">
    {% for b in badges %}<span class="badge">{{ b.label }} {{ b.count }}</span>{% endfor %}
    {% if not badges %}<span class="badge">无平台样本</span>{% endif %}
  </div>
  {% if coverage_note %}<p class="d-note">采集说明：{{ coverage_note }}</p>{% endif %}
  {% if mode == "faq" %}<p class="d-note">诚实边界：本 FAQ 类报告未做平台数据采集，内容基于通用租房知识与当前会话材料，不包含对具体楼盘或平台的舆情统计。</p>{% endif %}
  {% if mode in ["diligence","recommend"] %}<p class="d-note">风险评分 0-100，分数越高代表口碑风险越高；数据不足的维度按 0 计入，不代表无风险。</p>{% endif %}
  {% if total_kept is not none %}<p class="d-stat">样本：原始 {{ total_raw }} 条 / 有效 {{ total_kept }} 条</p>{% endif %}
  {% if time_distribution is defined and time_distribution %}
  {% if time_distribution is string %}
  <p class="d-stat">时间分布：{{ time_distribution }}</p>
  {% elif time_distribution.recent_1y is defined or time_distribution.y1_2 is defined or time_distribution.older is defined %}
  <p class="d-stat">时间分布：近1年 {{ time_distribution.recent_1y|default(0) }} · 1-2年 {{ time_distribution.y1_2|default(0) }} · 更早 {{ time_distribution.older|default(0) }}</p>
  {% endif %}
  {% endif %}
  <p class="d-note">数据来源为公开平台口碑帖聚合，样本有限且可能滞后；无数据不等于安全，重要决策请实地核验并核对产权与合同。{% if geo and geo.usable %}地理数据来自高德地图开放平台。{% endif %}{% if geo and geo.usable and geo.route and not show_commute %}高德返回的路线数据因未确认通勤目的地，未参与本报告结论。{% endif %}</p>
  <div class="d-disc"><strong>免责声明：</strong>{{ disclaimer }}</div>
  {% if geo and geo.usable and ((geo.noise and geo.noise.hits) or (geo.route and not show_commute)) %}
  <details class="d-raw">
    <summary>高德原始数据附录（默认不参与结论，点开查看）</summary>
    {% if geo.route and not show_commute %}
    <p>路线原始记录：{{ geo.route.mode_label }} · 约 {{ geo.route.duration_min }} 分钟 · {{ '%.1f'|format(geo.route.distance_m / 1000) }} 公里 · {{ geo.route.summary }}</p>
    {% endif %}
    {% if geo.noise and geo.noise.hits %}
    <p>周边检索原始记录（共 {{ geo.noise.total or geo.noise.hits|length }} 处）：{% for h in geo.noise.hits %}{{ h.type }} {{ h.name }} {{ dist_txt(h.distance_m) }}{% if not loop.last %}；{% endif %}{% endfor %}</p>
    {% endif %}
  </details>
  {% endif %}
  <p class="d-time">报告生成 {{ rendered_at }}{% if data_generated_at %} · 数据清洗 {{ data_generated_at }}{% endif %}</p>
  {{ city_scene() }}
  {% endcall %}

</main>

{# ===================== 底部翻页导航 ===================== #}
<nav class="deck-nav" id="deck-nav" aria-label="报告翻页">
  <button class="nav-btn" id="deck-prev" type="button" aria-label="上一页">&#8249;</button>
  <div class="dots" id="deck-dots"></div>
  <span class="page-no" id="deck-count">1/1</span>
  <button class="nav-btn" id="deck-next" type="button" aria-label="下一页">&#8250;</button>
</nav>

<script>
(function(){
  var deck = document.getElementById('deck');
  var cards = deck ? [].slice.call(deck.querySelectorAll('.card')) : [];
  var dots = document.getElementById('deck-dots');
  var countEl = document.getElementById('deck-count');
  var prev = document.getElementById('deck-prev');
  var next = document.getElementById('deck-next');
  var bar = document.getElementById('deck-progress');
  if (!deck || !cards.length) return;
  var cur = 0;
  cards.forEach(function(c, i){
    var d = document.createElement('button');
    d.type = 'button'; d.className = 'dot';
    d.setAttribute('aria-label', '看第 ' + (i + 1) + ' 页');
    d.addEventListener('click', function(){ go(i); });
    dots.appendChild(d);
  });
  function go(i){
    i = Math.max(0, Math.min(cards.length - 1, i));
    cards[i].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
  }
  function setCur(i){
    cur = i;
    countEl.textContent = (i + 1) + '/' + cards.length;
    [].forEach.call(dots.children, function(d, j){ d.classList.toggle('on', j === i); });
    prev.disabled = i === 0;
    next.disabled = i === cards.length - 1;
    if (bar) bar.style.width = ((i + 1) / cards.length * 100) + '%';
    animateCard(cards[i]);
  }
  /* 卡片首次成为当前卡时：条形从 0 过渡到实际宽，分数 0 滚到实际值；reduced-motion 直显终值 */
  function animateCard(c){
    if (!c || c.getAttribute('data-animated')) return;
    c.setAttribute('data-animated', '1');
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    [].forEach.call(c.querySelectorAll('.bar i'), function(b, i){
      var w = getComputedStyle(b).getPropertyValue('--w');
      b.style.transition = 'none';
      b.style.width = '0%';
      void b.offsetWidth;
      b.style.transition = 'width .7s cubic-bezier(.25,.46,.35,1) ' + (i * 70) + 'ms';
      b.style.width = w;
    });
    var ring = c.querySelector('.ring');
    var nums = [].slice.call(c.querySelectorAll('[data-count]'));
    if (!nums.length && !ring) return;
    var t0 = null, DUR = 650;
    function ease(k){ return 1 - Math.pow(1 - k, 3); }
    function step(ts){
      if (t0 === null) t0 = ts;
      var k = Math.min(1, (ts - t0) / DUR), v = ease(k);
      nums.forEach(function(el){
        el.textContent = Math.round(parseFloat(el.getAttribute('data-count')) * v);
      });
      if (ring) ring.style.setProperty('--p', String(parseFloat(ring.getAttribute('data-p')) * v));
      if (k < 1) requestAnimationFrame(step);
      else {
        nums.forEach(function(el){ el.textContent = el.getAttribute('data-count'); });
        if (ring) ring.style.setProperty('--p', ring.getAttribute('data-p'));
      }
    }
    requestAnimationFrame(step);
  }
  var io = ('IntersectionObserver' in window)
    ? new IntersectionObserver(function(es){
        es.forEach(function(e){ if (e.isIntersecting) setCur(cards.indexOf(e.target)); });
      }, { root: deck, threshold: 0.55 })
    : null;
  if (io) { cards.forEach(function(c){ io.observe(c); }); }
  prev.addEventListener('click', function(){ go(cur - 1); });
  next.addEventListener('click', function(){ go(cur + 1); });
  document.addEventListener('keydown', function(e){
    if (e.key === 'ArrowRight') { go(cur + 1); }
    else if (e.key === 'ArrowLeft') { go(cur - 1); }
  });
  setCur(0);
  var nav = document.getElementById('deck-nav');
  if (cards.length < 2 && nav) nav.classList.add('single');
})();
(function(){
  var sc = document.querySelector('.city-scene');
  if (!sc) return;
  var h = new Date().getHours();
  if (h >= 18 || h < 6) sc.classList.add('night');
})();
</script>
</body>
</html>
